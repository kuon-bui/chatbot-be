{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@enums":["src/common/enums/index"],
      "@decorators":["src/common/decorators/index"],
      "@schemas":["src/common/schemas/index"],
      "@dto":["src/common/dto/index"],
      "@interfaces":["src/common/interfaces/index"],
      "@repositories":["src/common/repositories/index"],
      "@guards":["src/common/guards/index"],
      "@strategies":["src/common/strategies/index"],
      "@rsa/*":["src/rsa/*"]
    }
  }
}
